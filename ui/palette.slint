export struct Row { title: string, detail: string, shortcut: string, disabled: bool, submenu: bool }

export component Palette inherits Window {
  title: "Hyper Palette · Prototype";
  no-frame: true;
  always-on-top: true;
  background: transparent;
  width: 680px;
  height: (100 + 52 * max(1, min(9, root.rows.length))) * 1px;
  in property <[Row]> rows;
  in property <int> selected: -1;
  in property <string> heading;
  in property <string> footer;
  in property <string> count-label;
  in property <string> empty-label;
  in property <bool> dark: false;
  in property <bool> composing: false;
  out property <length> corner-radius: 13px;
  in-out property <string> query;
  in-out property <length> scroll-y <=> list.viewport-y;
  private property <color> fg: dark ? #f1f1f4 : #242428;
  private property <color> muted: dark ? #96969f : #82828c;
  callback search(string);
  callback navigate(int);
  callback hover(int);
  callback choose(int);
  callback activate();
  callback back();
  callback dismiss();
  callback accelerator(string);
  callback dispatch-command(string);
  public function focus-input() { input.focus(); }
  forward-focus: keys;
  Rectangle {
    border-radius: root.corner-radius;
    border-width: 1px;
    border-color: root.dark ? #ffffff0c : #0000000d;
    background: root.dark ? #232328 : #f5f5f7;
  }
  keys := FocusScope {
    forward-focus: input;
    capture-key-pressed(event) => {
      if root.composing { return reject; }
      if event.text == Key.Escape { root.dismiss(); return accept; }
      if event.text == Key.UpArrow { root.navigate(-1); return accept; }
      if event.text == Key.DownArrow { root.navigate(1); return accept; }
      if event.text == Key.Backspace && root.query == "" { root.back(); return accept; }
      if event.modifiers.control && event.modifiers.alt {
        if event.text.to-lowercase() == "j" { root.navigate(1); return accept; }
        if event.text.to-lowercase() == "k" { root.navigate(-1); return accept; }
        if event.text.to-lowercase() == "h" { root.back(); return accept; }
        if event.text.to-lowercase() == "l" { root.activate(); return accept; }
      }
      if event.modifiers.alt && !event.modifiers.control { root.accelerator(event.text); return accept; }
      return reject;
    }
    Rectangle {
      x: 22px; y: 0; width: parent.width - 96px; height: 66px; clip: true;
      Text {
        x: 0; width: parent.width; height: parent.height; horizontal-alignment: left;
        visible: root.query == "" && !root.composing;
        text: root.heading; color: root.muted; font-size: 25px;
        vertical-alignment: center; overflow: elide;
      }
      input := TextInput {
        text <=> root.query;
        font-size: 25px; color: root.fg; single-line: true;
        width: max(parent.width, self.preferred-width);
        vertical-alignment: center;
        selection-background-color: #6559dc;
        selection-foreground-color: white;
        edited => { root.search(self.text); }
        accepted => { if !root.composing { root.activate(); } }
        cursor-position-changed(pos) => {
          if pos.x + self.x < 0px { self.x = -pos.x; }
          if pos.x + self.x > parent.width - 2px { self.x = parent.width - pos.x - 2px; }
        }
      }
    }
    // Right-hand brand mark, leaving the text cursor aligned with row titles.
    Image {
      x: parent.width - 54px; y: 17px; width: 32px; height: 32px;
      source: @image-url("../assets/hyper.svg");
    }
    Rectangle { y: 65px; height: 1px; background: root.dark ? #ffffff0c : #0000000d; }
    list := Flickable {
      x: 1px; y: 66px; width: parent.width - 2px;
      height: 52px * max(1, min(9, root.rows.length));
      viewport-width: self.width;
      viewport-height: 52px * root.rows.length;
      interactive: true;
      for row[index] in root.rows: Rectangle {
        y: index * 52px; width: list.width; height: 52px;
        background: index == root.selected ? (root.dark ? #6559dc : #6357d9) : transparent;
        opacity: row.disabled ? 0.45 : 1;
        accessible-role: list-item;
        accessible-label: row.title;
        Text {
          x: 21px; y: row.detail == "" ? 0px : 7px;
          width: parent.width - 152px; height: row.detail == "" ? parent.height : 23px;
          vertical-alignment: center;
          text: row.title; font-size: 16px; font-weight: 500; overflow: elide;
          color: index == root.selected ? white : root.fg;
        }
        Text {
          x: 21px; y: 31px; width: parent.width - 152px; height: 15px;
          text: row.detail; font-size: 11px; overflow: elide;
          color: index == root.selected ? #ffffffb3 : root.muted;
        }
        Text {
          x: parent.width - 120px; width: 98px; height: parent.height;
          text: row.shortcut + (row.submenu ? "  ›" : ""); font-size: 12px;
          color: index == root.selected ? #ffffffb3 : root.muted;
          horizontal-alignment: right; vertical-alignment: center;
        }
        TouchArea {
          enabled: !row.disabled;
          pointer-event(event) => {
            if event.kind == PointerEventKind.move { root.hover(index); }
          }
          clicked => { root.choose(index); }
        }
      }
    }
    if root.rows.length == 0: Text {
      y: 66px; height: 52px; text: root.empty-label;
      color: root.muted; horizontal-alignment: center; vertical-alignment: center;
    }
    Rectangle {
      y: parent.height - 33px; height: 1px;
      background: root.dark ? #ffffff0c : #0000000d;
    }
    Text {
      x: 22px; y: parent.height - 33px; width: parent.width - 150px; height: 32px;
      text: root.footer; font-size: 10px; color: root.muted; vertical-alignment: center;
    }
    Text {
      x: parent.width - 122px; y: parent.height - 33px; width: 100px; height: 32px;
      text: root.count-label; font-size: 10px; color: root.muted;
      horizontal-alignment: right; vertical-alignment: center;
    }
  }
}
